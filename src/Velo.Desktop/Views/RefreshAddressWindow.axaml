<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Velo.Desktop.Views.RefreshAddressWindow"
        Title="Refresh Download Address"
        Icon="/Assets/Velo.ico"
        Width="540" Height="270"
        MinWidth="480" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        Background="#1E1E22"
        Foreground="#F1F5F9">

    <Window.Styles>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="#2A2D36" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="#374151" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="#0369A1" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18,16">
        <!-- Bottom Buttons -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Classes="primaryBtn" Content="Update URL" Click="OnUpdateClick" />
                <Button Classes="dialogBtn" Content="Cancel" Click="OnCancelClick" />
            </StackPanel>
        </Border>

        <!-- Fields -->
        <StackPanel Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Refresh Download Address" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
            <TextBlock Text="If the download link has expired or changed, enter the refreshed link below to continue downloading without restarting from the beginning."
                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />

            <!-- Current Address -->
            <StackPanel Spacing="4">
                <TextBlock Text="Original Address:" FontSize="11" Foreground="#94A3B8" />
                <TextBox x:Name="CurrentUrlBox" IsReadOnly="True" Height="28" FontSize="11" Background="#141416" BorderBrush="#2F333E" Foreground="#64748B" />
            </StackPanel>

            <!-- New Address -->
            <StackPanel Spacing="4">
                <TextBlock Text="New / Refreshed Address:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                <TextBox x:Name="NewUrlBox" Height="30" FontSize="12" Background="#141416" BorderBrush="#3F4452" Foreground="#F8FAFC" Watermark="https://..." />
            </StackPanel>

            <TextBlock x:Name="StatusMessage" Text="" FontSize="11" Foreground="#10B981" />
        </StackPanel>
    </DockPanel>
</Window>
