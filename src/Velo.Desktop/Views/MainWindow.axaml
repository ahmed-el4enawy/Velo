<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velo.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Velo.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Width="1100" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#12141A">

    <Grid ColumnDefinitions="240,*">
        <!-- Left Sidebar Navigation Rail -->
        <Border Grid.Column="0" Background="#181B22" BorderBrush="#252A36" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <!-- Branding Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,24">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#6366F1">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VELO" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" />
                        <TextBlock Text="Multi-Stream Engine" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Rail Filters -->
                <ScrollViewer>
                    <StackPanel Spacing="6">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="All Downloads"
                                Background="#242938" Foreground="#F8FAFC">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="📥" />
                                <TextBlock Text="All Downloads" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Downloading"
                                Background="Transparent" Foreground="#94A3B8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⚡" />
                                <TextBlock Text="Downloading" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Queued"
                                Background="Transparent" Foreground="#94A3B8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⏳" />
                                <TextBlock Text="Queued" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Paused"
                                Background="Transparent" Foreground="#94A3B8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⏸️" />
                                <TextBlock Text="Paused" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Completed"
                                Background="Transparent" Foreground="#94A3B8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="✅" />
                                <TextBlock Text="Completed" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Failed"
                                Background="Transparent" Foreground="#94A3B8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="❌" />
                                <TextBlock Text="Failed" />
                            </StackPanel>
                        </Button>

                        <Separator Background="#252A36" Margin="0,12" />

                        <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="8,4" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Compressed"
                                Background="Transparent" Foreground="#94A3B8">
                            <TextBlock Text="📦 Compressed" />
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Video"
                                Background="Transparent" Foreground="#94A3B8">
                            <TextBlock Text="🎬 Video" />
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Music"
                                Background="Transparent" Foreground="#94A3B8">
                            <TextBlock Text="🎵 Music" />
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Documents"
                                Background="Transparent" Foreground="#94A3B8">
                            <TextBlock Text="📄 Documents" />
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="6"
                                Command="{Binding SelectCategoryCommand}" CommandParameter="Programs"
                                Background="Transparent" Foreground="#94A3B8">
                            <TextBlock Text="💻 Programs" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <!-- Top Action Toolbar -->
            <Border Grid.Row="0" Background="#14171F" BorderBrush="#252A36" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <Button Background="#4F46E5" Foreground="White" Padding="14,8" CornerRadius="6" Command="{Binding OpenAddDownloadDialogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="➕" VerticalAlignment="Center" />
                                <TextBlock Text="Add Download" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Background="#242938" Foreground="#E2E8F0" Padding="12,8" CornerRadius="6" Command="{Binding ResumeAllCommand}">
                            <TextBlock Text="▶ Resume All" />
                        </Button>
                        <Button Background="#242938" Foreground="#E2E8F0" Padding="12,8" CornerRadius="6" Command="{Binding PauseAllCommand}">
                            <TextBlock Text="⏸ Pause All" />
                        </Button>
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Column="2" Width="260" Watermark="Search downloads..." Text="{Binding SearchQuery}" CornerRadius="6" Background="#1E2330" BorderBrush="#2E3547" Foreground="#F8FAFC" />
                </Grid>
            </Border>

            <!-- Download List Area -->
            <ScrollViewer Grid.Row="1" Padding="16">
                <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <Border Background="#181B24" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- Title & Host -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Status Badge & Speed -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                        <Border CornerRadius="4" Padding="8,4" Background="#1E293B">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{Binding SpeedText}" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="6" CornerRadius="3" Margin="0,12"
                                                 Value="{Binding ProgressPercentage}" Maximum="100" Background="#232938" Foreground="#6366F1" />

                                    <!-- Footer Stats & Actions -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeInfo}" FontSize="12" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding EtaText}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Padding="10,5" CornerRadius="5" Background="#272F42" Foreground="#E2E8F0" FontSize="12" Command="{Binding ResumeCommand}" Content="▶ Resume" />
                                            <Button Padding="10,5" CornerRadius="5" Background="#272F42" Foreground="#E2E8F0" FontSize="12" Command="{Binding PauseCommand}" Content="⏸ Pause" />
                                            <Button Padding="10,5" CornerRadius="5" Background="#272F42" Foreground="#E2E8F0" FontSize="12" Command="{Binding OpenFolderCommand}" Content="📂 Folder" />
                                            <Button Padding="10,5" CornerRadius="5" Background="#3B2329" Foreground="#F87171" FontSize="12" Command="{Binding CancelCommand}" Content="✕ Cancel" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#14171F" BorderBrush="#252A36" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Ready • Windows 10 x64 Engine • Offline-first (Zero Telemetry)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="Active Streams: 0/24" FontSize="12" Foreground="#94A3B8" />
                        <TextBlock Text="Total Speed: 0.0 MB/s" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
