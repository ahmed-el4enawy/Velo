<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velo.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="Velo.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Icon="/Assets/Velo.ico"
        Width="1140" Height="700"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015">

    <Window.Styles>
        <!-- Gold / Obsidian Ribbon Button Style -->
        <Style Selector="Button.ribbonBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ribbonBtn:pointerover">
            <Setter Property="Background" Value="#1C1F2B" />
            <Setter Property="BorderBrush" Value="#453B21" />
        </Style>
        <Style Selector="Button.ribbonBtn:pressed">
            <Setter Property="Background" Value="#2E2514" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>

        <!-- Category Item Style -->
        <Style Selector="Button.categoryBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.categoryBtn:pointerover">
            <Setter Property="Background" Value="#1A1C24" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
        <Style Selector="Button.categoryBtn.active">
            <Setter Property="Background" Value="#221D0E" />
            <Setter Property="Foreground" Value="#FBBF24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>

        <!-- Dense Data Row ListBox Item Style with Gold Accent Selection -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#1B1D24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="#121317" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n+1)">
            <Setter Property="Background" Value="#0E1015" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#1F222B" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#272314" />
            <Setter Property="BorderThickness" Value="2,0,0,1" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>

        <!-- Context Menu Dark Styling with Amber Accents -->
        <Style Selector="ContextMenu.idmContextMenu">
            <Setter Property="Background" Value="#15171E" />
            <Setter Property="BorderBrush" Value="#2E2B20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style Selector="ContextMenu.idmContextMenu MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="ContextMenu.idmContextMenu MenuItem:pointerover">
            <Setter Property="Background" Value="#28251B" />
            <Setter Property="Foreground" Value="#FBBF24" />
        </Style>
        <Style Selector="ContextMenu.idmContextMenu MenuItem:disabled">
            <Setter Property="Foreground" Value="#4B5563" />
        </Style>
        <Style Selector="ContextMenu.idmContextMenu Separator">
            <Setter Property="Background" Value="#252730" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+M" Command="{Binding MoveRenameSelectedCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedWithDialogCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- 1. Top Classical Menu Bar (Tasks, File, Downloads, View, Help) -->
        <Border DockPanel.Dock="Top" Background="#121318" BorderBrush="#252732" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="#E2E8F0" FontSize="12">
                <!-- 1. Tasks Menu -->
                <MenuItem Header="_Tasks">
                    <MenuItem Header="Add new download" Command="{Binding OpenAddDownloadDialogCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="Add batch download" Command="{Binding OpenGrabberDialogCommand}" />
                    <MenuItem Header="Add batch download from clipboard" Command="{Binding PasteAndAddDownloadCommand}" InputGesture="Ctrl+V" />
                    <MenuItem Header="Run site grabber" Command="{Binding OpenGrabberDialogCommand}" />
                    <Separator />
                    <MenuItem Header="Show drop target" Command="{Binding OpenSettingsDialogCommand}" />
                    <Separator />
                    <MenuItem Header="Export">
                        <MenuItem Header="To text file" Command="{Binding ExportDownloadsCommand}" CommandParameter="txt" />
                        <MenuItem Header="To IDM export file" Command="{Binding ExportDownloadsCommand}" CommandParameter="ef2" />
                    </MenuItem>
                    <MenuItem Header="Import">
                        <MenuItem Header="From text file" Command="{Binding ImportDownloadsCommand}" />
                        <MenuItem Header="From IDM export file" Command="{Binding ImportDownloadsCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding CloseAppCommand}" />
                </MenuItem>

                <!-- 2. File Menu -->
                <MenuItem Header="_File">
                    <MenuItem Header="Stop Download" Command="{Binding StopSelectedCommand}" />
                    <MenuItem Header="Remove" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
                    <MenuItem Header="Download Now" Command="{Binding ResumeSelectedCommand}" />
                    <MenuItem Header="Redownload" Command="{Binding RedownloadSelectedCommand}" />
                </MenuItem>

                <!-- 3. Downloads Menu -->
                <MenuItem Header="_Downloads">
                    <MenuItem Header="Pause All" Command="{Binding PauseAllCommand}" />
                    <MenuItem Header="Stop All" Command="{Binding PauseAllCommand}" />
                    <Separator />
                    <MenuItem Header="Delete All Completed" Command="{Binding DeleteCompletedCommand}" />
                    <Separator />
                    <MenuItem Header="Find (Ctrl-F)" Command="{Binding FocusSearchCommand}" InputGesture="Ctrl+F" />
                    <MenuItem Header="Find Next (F3)" Command="{Binding FocusSearchCommand}" InputGesture="F3" />
                    <Separator />
                    <MenuItem Header="Scheduler" Command="{Binding OpenSettingsDialogCommand}" />
                    <MenuItem Header="Start queue">
                        <MenuItem Header="Start main download queue" Command="{Binding ResumeAllCommand}" />
                        <MenuItem Header="Start synchronization queue" Command="{Binding ResumeAllCommand}" />
                    </MenuItem>
                    <MenuItem Header="Stop queue">
                        <MenuItem Header="Stop main download queue" Command="{Binding PauseAllCommand}" />
                        <MenuItem Header="Stop synchronization queue" Command="{Binding PauseAllCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Speed Limiter">
                        <MenuItem Header="Turn ON" Command="{Binding ToggleSpeedLimiterCommand}" CommandParameter="True">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" IsVisible="{Binding IsSpeedLimiterEnabled}" FontWeight="Bold" Foreground="#F59E0B" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Turn OFF" Command="{Binding ToggleSpeedLimiterCommand}" CommandParameter="False" />
                        <Separator />
                        <MenuItem Header="Settings..." Command="{Binding OpenSettingsDialogCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Options" Command="{Binding OpenSettingsDialogCommand}" />
                </MenuItem>

                <!-- 4. View Menu -->
                <MenuItem Header="_View">
                    <MenuItem Header="Hide categories" Command="{Binding ToggleCategoriesVisibilityCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="✓" IsVisible="{Binding !IsCategoriesVisible}" FontWeight="Bold" Foreground="#F59E0B" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Arrange files">
                        <MenuItem Header="by Name" Command="{Binding SetSortCommand}" CommandParameter="Name" />
                        <MenuItem Header="by Size" Command="{Binding SetSortCommand}" CommandParameter="Size" />
                        <MenuItem Header="by Status" Command="{Binding SetSortCommand}" CommandParameter="Status" />
                        <MenuItem Header="by Time left" Command="{Binding SetSortCommand}" CommandParameter="Time Left" />
                        <MenuItem Header="by Transfer rate" Command="{Binding SetSortCommand}" CommandParameter="Transfer Rate" />
                        <MenuItem Header="by Date added" Command="{Binding SetSortCommand}" CommandParameter="Date" />
                    </MenuItem>
                    <MenuItem Header="Toolbar">
                        <MenuItem Header="Standard Buttons" Command="{Binding ToggleToolbarVisibilityCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="✓" IsVisible="{Binding IsToolbarVisible}" FontWeight="Bold" Foreground="#F59E0B" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="IDM tray icon">
                        <MenuItem Header="Minimize to tray" Command="{Binding OpenSettingsDialogCommand}" />
                        <MenuItem Header="Always show in tray" Command="{Binding OpenSettingsDialogCommand}" />
                    </MenuItem>
                    <MenuItem Header="Customize URL List..." Command="{Binding OpenSettingsDialogCommand}" />
                    <MenuItem Header="Dark Mode support">
                        <MenuItem.Icon>
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="#F59E0B" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Font">
                        <MenuItem Header="Segoe UI (Default)" />
                        <MenuItem Header="Consolas" />
                        <MenuItem Header="Roboto" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Language">
                        <MenuItem Header="English" />
                        <MenuItem Header="Arabic (العربية)" />
                        <MenuItem Header="French (Français)" />
                        <MenuItem Header="German (Deutsch)" />
                    </MenuItem>
                </MenuItem>

                <!-- 5. Help Menu -->
                <MenuItem Header="_Help">
                    <MenuItem Header="Help contents" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.internetdownloadmanager.com/support/" />
                    <MenuItem Header="Tutorials" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.internetdownloadmanager.com/support/tutorials.html" />
                    <MenuItem Header="Scheduler and queues" Command="{Binding OpenSettingsDialogCommand}" />
                    <MenuItem Header="Grabber Help" Command="{Binding OpenGrabberDialogCommand}" />
                    <MenuItem Header="Tip of the Day..." Command="{Binding ShowAboutDialogCommand}" />
                    <Separator />
                    <MenuItem Header="IDM Home Page" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.internetdownloadmanager.com" />
                    <MenuItem Header="Contact IDM Support" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.internetdownloadmanager.com/support/" />
                    <Separator />
                    <MenuItem Header="Check for updates..." Command="{Binding ShowAboutDialogCommand}" />
                    <Separator />
                    <MenuItem Header="About IDM" Command="{Binding ShowAboutDialogCommand}" />
                    <MenuItem Header="Tell a friend" Command="{Binding ShowAboutDialogCommand}" />
                </MenuItem>

                <!-- 6. Registration Menu -->
                <MenuItem Header="_Registration">
                    <MenuItem Header="Register Velo..." Command="{Binding ShowAboutDialogCommand}" />
                    <MenuItem Header="Registration details" Command="{Binding ShowAboutDialogCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. Refined Obsidian & Gold Ribbon Toolbar -->
        <Border DockPanel.Dock="Top" Background="#14161E" BorderBrush="#262834" BorderThickness="0,0,0,1" Padding="8,5" IsVisible="{Binding IsToolbarVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                    <!-- Add URL -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenAddDownloadDialogCommand}" ToolTip.Tip="Add download URL">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#F59E0B" BorderThickness="1.5" Background="#261E0A" HorizontalAlignment="Center">
                                <TextBlock Text="➕" FontSize="11" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Add URL" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Resume -->
                    <Button Classes="ribbonBtn" Command="{Binding ResumeSelectedCommand}" ToolTip.Tip="Resume selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#EAB308" BorderThickness="1.5" Background="#241E09" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="11" Foreground="#FDE047" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Resume" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop -->
                    <Button Classes="ribbonBtn" Command="{Binding StopSelectedCommand}" ToolTip.Tip="Stop selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="5" BorderBrush="#4B5563" BorderThickness="1.5" Background="#1E2028" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop All -->
                    <Button Classes="ribbonBtn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Stop all downloads">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="5" BorderBrush="#6B7280" BorderThickness="1.5" Background="#222530" HorizontalAlignment="Center">
                                <TextBlock Text="🛑" FontSize="11" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop All" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Delete -->
                    <Button Classes="ribbonBtn" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#4B5563" BorderThickness="1.5" Background="#1B1D24" HorizontalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Delete" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Delete Completed -->
                    <Button Classes="ribbonBtn" Command="{Binding DeleteCompletedCommand}" ToolTip.Tip="Delete completed downloads from list">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#52525B" BorderThickness="1.5" Background="#1E2028" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Delete C..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="34" Background="#2A2D3A" Margin="4,0" />

                    <!-- Options -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="Options and settings">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#D97706" BorderThickness="1.5" Background="#241B08" HorizontalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Options" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Scheduler -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="Scheduler &amp; Concurrency limits">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#F59E0B" BorderThickness="1.5" Background="#261E0A" HorizontalAlignment="Center">
                                <TextBlock Text="⏰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Scheduler" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Start Queue -->
                    <Button Classes="ribbonBtn" Command="{Binding ResumeAllCommand}" ToolTip.Tip="Start download queue">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="5" BorderBrush="#EAB308" BorderThickness="1.5" Background="#241E09" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="11" Foreground="#FDE047" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Start Qu..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Queue -->
                    <Button Classes="ribbonBtn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Stop download queue">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="5" BorderBrush="#B45309" BorderThickness="1.5" Background="#221706" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="11" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop Qu..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Grabber -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenGrabberDialogCommand}" ToolTip.Tip="Site Grabber">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#71717A" BorderThickness="1.5" Background="#1F212A" HorizontalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Grabber" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Tell a Friend / About -->
                    <Button Classes="ribbonBtn" Command="{Binding ShowAboutDialogCommand}" ToolTip.Tip="About Velo">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#F59E0B" BorderThickness="1.5" Background="#261E0A" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="About" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Minimal Gold-Accented Search Filter Box on Right -->
                <TextBox Grid.Column="2" Width="210" Watermark="Search downloads..." Text="{Binding SearchQuery}" CornerRadius="6" Background="#0C0E13" BorderBrush="#2A2D3A" Foreground="#F8FAFC" VerticalAlignment="Center" Height="29" FontSize="12" Padding="8,4" />
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#0C0E13" BorderBrush="#1F222C" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusBarInfo}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="#181B24" BorderBrush="#262A37" BorderThickness="1" CornerRadius="4" Padding="8,2" IsVisible="{Binding IsSpeedLimiterEnabled}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="⚡" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="Speed Limit: Active" FontSize="10" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ActiveStreamsCount, StringFormat='Active Streams: {0}/24'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <Border Background="#201A09" BorderBrush="#3F3415" BorderThickness="1" CornerRadius="4" Padding="10,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalSpeedText, StringFormat='Throughput: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Body: Left Categories Tree + Right IDM Downloads Table -->
        <Grid ColumnDefinitions="Auto,Auto,*">
            <!-- Left Categories Box -->
            <Border Grid.Column="0" Width="215" Background="#111319" BorderBrush="#232631" BorderThickness="1" Margin="6,6,0,6" CornerRadius="4" IsVisible="{Binding IsCategoriesVisible}">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#181A22" Padding="10,6" BorderBrush="#232631" BorderThickness="0,0,0,1">
                        <TextBlock Text="Categories" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" />
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="1" Margin="4,4">
                            <!-- All Downloads -->
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryAll}" Command="{Binding SelectCategoryCommand}" CommandParameter="All Downloads" FontWeight="SemiBold">
                                <TextBlock Text="📁 All Downloads" />
                            </Button>

                            <!-- Subcategories -->
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryCompressed}" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Compressed">
                                <TextBlock Text="🗜️ Compressed" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryDocuments}" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Documents">
                                <TextBlock Text="📄 Documents" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryMusic}" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Music">
                                <TextBlock Text="🎵 Music" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryPrograms}" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Programs">
                                <TextBlock Text="💻 Programs" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryVideo}" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Video">
                                <TextBlock Text="🎬 Video" />
                            </Button>

                            <Separator Background="#232631" Margin="0,4" />

                            <!-- Status filters -->
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryUnfinished}" Command="{Binding SelectCategoryCommand}" CommandParameter="Unfinished">
                                <TextBlock Text="⏳ Unfinished" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryFinished}" Command="{Binding SelectCategoryCommand}" CommandParameter="Finished">
                                <TextBlock Text="✅ Finished" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryGrabber}" Command="{Binding SelectCategoryCommand}" CommandParameter="Grabber projects">
                                <TextBlock Text="🌐 Grabber projects" />
                            </Button>
                            <Button Classes="categoryBtn" Classes.active="{Binding IsCategoryQueues}" Command="{Binding SelectCategoryCommand}" CommandParameter="Queues">
                                <TextBlock Text="📋 Queues" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="#0E1015" ResizeDirection="Columns" IsVisible="{Binding IsCategoriesVisible}" />

            <!-- Right Downloads Data Table -->
            <Border Grid.Column="2" Background="#101117" BorderBrush="#232631" BorderThickness="1" Margin="0,6,6,6" CornerRadius="4">
                <DockPanel>
                    <!-- Table Column Header Row -->
                    <Border DockPanel.Dock="Top" Background="#181A22" BorderBrush="#232631" BorderThickness="0,0,0,1" Height="26">
                        <Grid ColumnDefinitions="280,30,85,90,80,100,105,*">
                            <!-- File Name -->
                            <Border Grid.Column="0" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="File Name" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Q (Queue) -->
                            <Border Grid.Column="1" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="4,4">
                                <TextBlock Text="Q" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Size -->
                            <Border Grid.Column="2" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Size" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Border>

                            <!-- Status -->
                            <Border Grid.Column="3" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Time left -->
                            <Border Grid.Column="4" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Time left" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Transfer rate -->
                            <Border Grid.Column="5" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Transfer rate" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Border>

                            <!-- Last Try Date -->
                            <Border Grid.Column="6" BorderBrush="#2A2D3A" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Last Try Date ˅" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Description -->
                            <Border Grid.Column="7" Padding="8,4">
                                <TextBlock Text="Description" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Interactive Empty State when no downloads are queued/present -->
                    <Border IsVisible="{Binding !HasFilteredDownloads}" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#1F1B0B" BorderBrush="#F59E0B" BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="28" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="No downloads found" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                <TextBlock Text="Add a new URL or trigger downloads from Google Chrome" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button Command="{Binding OpenAddDownloadDialogCommand}" Background="#F59E0B" Foreground="#09090B" FontWeight="Bold" FontSize="12" Padding="20,7" CornerRadius="6" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Add New Download" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Table Data Rows -->
                    <ListBox ItemsSource="{Binding FilteredDownloads}"
                             SelectedItem="{Binding SelectedDownload}"
                             Background="Transparent"
                             BorderThickness="0"
                             DoubleTapped="OnRowDoubleTapped"
                             PointerPressed="OnListBoxPointerPressed"
                             IsVisible="{Binding HasFilteredDownloads}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Grid ColumnDefinitions="280,30,85,90,80,100,105,*" Background="Transparent" HorizontalAlignment="Stretch">
                                    <Grid.ContextMenu>
                                        <ContextMenu Classes="idmContextMenu">
                                            <MenuItem Header="Open" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpen}" />
                                            <MenuItem Header="Open with..." Command="{Binding OpenWithCommand}" IsEnabled="{Binding CanOpen}" />
                                            <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                            <Separator />
                                            <MenuItem Header="Move/Rename (Ctrl-M)" Command="{Binding MoveRenameCommand}" />
                                            <Separator />
                                            <MenuItem Header="Redownload" Command="{Binding RedownloadCommand}" />
                                            <Separator />
                                            <MenuItem Header="Resume Download" Command="{Binding ResumeDownloadCommand}" IsEnabled="{Binding CanResume}" />
                                            <MenuItem Header="Stop Download" Command="{Binding StopDownloadCommand}" IsEnabled="{Binding CanStop}" />
                                            <Separator />
                                            <MenuItem Header="Refresh download address" Command="{Binding RefreshAddressCommand}" IsEnabled="{Binding CanRefreshAddress}" />
                                            <Separator />
                                            <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                            <Separator />
                                            <MenuItem Header="Add to queue" IsEnabled="{Binding CanAddToQueue}">
                                                <MenuItem Header="Main download queue" Command="{Binding AddToQueueCommand}" CommandParameter="Main download queue" />
                                                <MenuItem Header="Synchronization queue" Command="{Binding AddToQueueCommand}" CommandParameter="Synchronization queue" />
                                            </MenuItem>
                                            <MenuItem Header="Delete from queue" Command="{Binding DeleteFromQueueCommand}" IsEnabled="{Binding CanDeleteFromQueue}" />
                                            <Separator />
                                            <MenuItem Header="On Double click">
                                                <MenuItem Header="Open file" Command="{Binding SetDoubleClickActionCommand}" CommandParameter="OpenFile">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="✓" IsVisible="{Binding IsDoubleClickOpenFile}" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Open download progress dialog" Command="{Binding SetDoubleClickActionCommand}" CommandParameter="OpenProgress">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="✓" IsVisible="{Binding IsDoubleClickOpenProgress}" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Open folder" Command="{Binding SetDoubleClickActionCommand}" CommandParameter="OpenFolder">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="✓" IsVisible="{Binding IsDoubleClickOpenFolder}" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Properties" Command="{Binding SetDoubleClickActionCommand}" CommandParameter="Properties">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="✓" IsVisible="{Binding IsDoubleClickProperties}" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Properties" Command="{Binding OpenPropertiesCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- 0: File Name with icon and strict ellipsis constraint -->
                                    <Border Grid.Column="0" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding FileIconEmoji}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- 1: Q indicator -->
                                    <Border Grid.Column="1" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="2,2">
                                        <TextBlock Text="📁" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                    </Border>

                                    <!-- 2: Size -->
                                    <Border Grid.Column="2" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding FormattedSizeOnly}" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 3: Status with mini progress bar -->
                                    <Border Grid.Column="3" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <Grid VerticalAlignment="Center">
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercentage}"
                                                         Foreground="#3F2B07"
                                                         Background="#161820"
                                                         BorderThickness="0"
                                                         CornerRadius="3"
                                                         Height="18"
                                                         Opacity="0.8"
                                                         IsVisible="{Binding IsActiveDownloading}" />
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="11"
                                                       Foreground="{Binding StatusColor}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0" />
                                        </Grid>
                                    </Border>

                                    <!-- 4: Time left -->
                                    <Border Grid.Column="4" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding TimeLeftText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 5: Transfer rate -->
                                    <Border Grid.Column="5" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding TransferRateText}" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 6: Last Try Date -->
                                    <Border Grid.Column="6" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding LastTryDateText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 7: Description / Host -->
                                    <Border Grid.Column="7" Padding="8,2">
                                        <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
