<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velo.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="Velo.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppTitle}"
        Icon="/Assets/Velo.ico"
        Width="1140" Height="700"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#18181A">

    <Window.Styles>
        <!-- IDM Ribbon Button Style -->
        <Style Selector="Button.ribbonBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
        <Style Selector="Button.ribbonBtn:pointerover">
            <Setter Property="Background" Value="#2A2D36" />
            <Setter Property="BorderBrush" Value="#3F4452" />
        </Style>

        <!-- Category Item Style -->
        <Style Selector="Button.categoryBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.categoryBtn:pointerover">
            <Setter Property="Background" Value="#252A36" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Dense Data Row ListBox Item Style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#252830" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="#1C1E24" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n+1)">
            <Setter Property="Background" Value="#17191E" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#262C3A" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#0A3A68" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- 1. Top Classical Menu Bar (Tasks, File, Downloads, View, Help) -->
        <Border DockPanel.Dock="Top" Background="#1E1E20" BorderBrush="#2C2C30" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="#E2E8F0" FontSize="12">
                <MenuItem Header="Tasks">
                    <MenuItem Header="Add new download..." Command="{Binding OpenAddDownloadDialogCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="Paste from clipboard" Command="{Binding PasteAndAddDownloadCommand}" InputGesture="Ctrl+V" />
                    <Separator />
                    <MenuItem Header="Exit" />
                </MenuItem>
                <MenuItem Header="File">
                    <MenuItem Header="Stop download" Command="{Binding StopSelectedCommand}" />
                    <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
                </MenuItem>
                <MenuItem Header="Downloads">
                    <MenuItem Header="Resume All" Command="{Binding ResumeAllCommand}" />
                    <MenuItem Header="Stop All" Command="{Binding PauseAllCommand}" />
                    <Separator />
                    <MenuItem Header="Delete Completed" Command="{Binding DeleteCompletedCommand}" />
                </MenuItem>
                <MenuItem Header="View">
                    <MenuItem Header="Toolbar" IsChecked="True" />
                    <MenuItem Header="Categories" IsChecked="True" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Options / Preferences" Command="{Binding OpenSettingsDialogCommand}" />
                    <Separator />
                    <MenuItem Header="About Velo..." Command="{Binding ShowAboutDialogCommand}" />
                </MenuItem>
                <MenuItem Header="Registration">
                    <MenuItem Header="Register Velo..." Command="{Binding ShowAboutDialogCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. IDM Ribbon Toolbar with vibrant neon action buttons -->
        <Border DockPanel.Dock="Top" Background="#222328" BorderBrush="#2F323A" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <!-- Add URL -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenAddDownloadDialogCommand}" ToolTip.Tip="Add download URL">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#06B6D4" BorderThickness="2" Background="#164E63" HorizontalAlignment="Center">
                                <TextBlock Text="➕" FontSize="11" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Add URL" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Resume -->
                    <Button Classes="ribbonBtn" Command="{Binding ResumeSelectedCommand}" ToolTip.Tip="Resume selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#10B981" BorderThickness="2" Background="#064E3B" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="12" Foreground="#34D399" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Resume" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop -->
                    <Button Classes="ribbonBtn" Command="{Binding StopSelectedCommand}" ToolTip.Tip="Stop selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="4" BorderBrush="#EF4444" BorderThickness="2" Background="#7F1D1D" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop All -->
                    <Button Classes="ribbonBtn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Stop all downloads">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="4" BorderBrush="#F97316" BorderThickness="2" Background="#7C2D12" HorizontalAlignment="Center">
                                <TextBlock Text="🛑" FontSize="11" Foreground="#FB923C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop All" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Delete -->
                    <Button Classes="ribbonBtn" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete selected download">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#EC4899" BorderThickness="2" Background="#831843" HorizontalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Delete" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Delete Completed -->
                    <Button Classes="ribbonBtn" Command="{Binding DeleteCompletedCommand}" ToolTip.Tip="Delete completed downloads from list">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#A855F7" BorderThickness="2" Background="#581C87" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Delete C..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="36" Background="#3E424D" Margin="4,0" />

                    <!-- Options -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="Options and settings">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#3B82F6" BorderThickness="2" Background="#1E3A8A" HorizontalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Options" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Scheduler -->
                    <Button Classes="ribbonBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="Scheduler &amp; Concurrency limits">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#F43F5E" BorderThickness="2" Background="#881337" HorizontalAlignment="Center">
                                <TextBlock Text="⏰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Scheduler" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Start Queue -->
                    <Button Classes="ribbonBtn" Command="{Binding ResumeAllCommand}" ToolTip.Tip="Start download queue">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="4" BorderBrush="#10B981" BorderThickness="2" Background="#064E3B" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="11" Foreground="#34D399" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Start Qu..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Queue -->
                    <Button Classes="ribbonBtn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Stop download queue">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="4" BorderBrush="#F59E0B" BorderThickness="2" Background="#78350F" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="11" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Stop Qu..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Grabber -->
                    <Button Classes="ribbonBtn" Command="{Binding ShowAboutDialogCommand}" ToolTip.Tip="Site Grabber">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#8B5CF6" BorderThickness="2" Background="#4C1D95" HorizontalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Grabber" FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Tell a Friend / About -->
                    <Button Classes="ribbonBtn" Command="{Binding ShowAboutDialogCommand}" ToolTip.Tip="About Velo">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <Border Width="26" Height="26" CornerRadius="13" BorderBrush="#FBBF24" BorderThickness="2" Background="#713F12" HorizontalAlignment="Center">
                                <TextBlock Text="👍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Tell a Frie..." FontSize="10" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search Filter Box on Right -->
                <TextBox Grid.Column="2" Width="200" Watermark="Search list..." Text="{Binding SearchQuery}" CornerRadius="4" Background="#17181C" BorderBrush="#353945" Foreground="#F8FAFC" VerticalAlignment="Center" Height="28" FontSize="12" />
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#1A1B1F" BorderBrush="#2C2E36" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBarInfo}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding ActiveStreamsCount, StringFormat='Streams: {0}/24'}" FontSize="11" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding TotalSpeedText, StringFormat='Speed: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Body: Left Categories Tree + Right IDM Downloads Table -->
        <Grid ColumnDefinitions="210,4,*">
            <!-- Left Categories Box -->
            <Border Grid.Column="0" Background="#1A1C22" BorderBrush="#2D313C" BorderThickness="1" Margin="6,6,0,6" CornerRadius="2">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#242832" Padding="8,5" BorderBrush="#2D313C" BorderThickness="0,0,0,1">
                        <TextBlock Text="Categories" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" />
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="1" Margin="4,4">
                            <!-- All Downloads -->
                            <Button Classes="categoryBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="All Downloads" FontWeight="SemiBold">
                                <TextBlock Text="📁 All Downloads" />
                            </Button>

                            <!-- Subcategories -->
                            <Button Classes="categoryBtn" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Compressed">
                                <TextBlock Text="🗜️ Compressed" />
                            </Button>
                            <Button Classes="categoryBtn" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Documents">
                                <TextBlock Text="📄 Documents" />
                            </Button>
                            <Button Classes="categoryBtn" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Music">
                                <TextBlock Text="🎵 Music" />
                            </Button>
                            <Button Classes="categoryBtn" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Programs">
                                <TextBlock Text="💻 Programs" />
                            </Button>
                            <Button Classes="categoryBtn" Margin="14,0,0,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Video">
                                <TextBlock Text="🎬 Video" />
                            </Button>

                            <Separator Background="#2D313C" Margin="0,4" />

                            <!-- Status filters -->
                            <Button Classes="categoryBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="Unfinished">
                                <TextBlock Text="⏳ Unfinished" />
                            </Button>
                            <Button Classes="categoryBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="Finished">
                                <TextBlock Text="✅ Finished" />
                            </Button>
                            <Button Classes="categoryBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="Grabber projects">
                                <TextBlock Text="🌐 Grabber projects" />
                            </Button>
                            <Button Classes="categoryBtn" Command="{Binding SelectCategoryCommand}" CommandParameter="Queues">
                                <TextBlock Text="📋 Queues" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#18181A" ResizeDirection="Columns" />

            <!-- Right Downloads Data Table -->
            <Border Grid.Column="2" Background="#17191E" BorderBrush="#2D313C" BorderThickness="1" Margin="0,6,6,6" CornerRadius="2">
                <DockPanel>
                    <!-- Table Column Header Row -->
                    <Border DockPanel.Dock="Top" Background="#232732" BorderBrush="#2D313C" BorderThickness="0,0,0,1" Height="24">
                        <Grid ColumnDefinitions="280,30,85,90,80,100,105,*">
                            <!-- File Name -->
                            <Border Grid.Column="0" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="File Name" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Q (Queue) -->
                            <Border Grid.Column="1" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="4,4">
                                <TextBlock Text="Q" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Size -->
                            <Border Grid.Column="2" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Size" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Border>

                            <!-- Status -->
                            <Border Grid.Column="3" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Time left -->
                            <Border Grid.Column="4" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Time left" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Transfer rate -->
                            <Border Grid.Column="5" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Transfer rate" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Border>

                            <!-- Last Try Date -->
                            <Border Grid.Column="6" BorderBrush="#353A47" BorderThickness="0,0,1,0" Padding="8,4">
                                <TextBlock Text="Last Try Date ˅" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>

                            <!-- Description -->
                            <Border Grid.Column="7" Padding="8,4">
                                <TextBlock Text="Description" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Table Data Rows -->
                    <ListBox ItemsSource="{Binding FilteredDownloads}" SelectedItem="{Binding SelectedDownload}" Background="Transparent" BorderThickness="0" DoubleTapped="OnRowDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Grid ColumnDefinitions="280,30,85,90,80,100,105,*">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                                            <MenuItem Header="Pause / Stop" Command="{Binding PauseCommand}" />
                                            <Separator />
                                            <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" />
                                            <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                            <Separator />
                                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                            <MenuItem Header="Details..." Command="{Binding OpenDetailsCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- 0: File Name with icon and strict ellipsis constraint -->
                                    <Border Grid.Column="0" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding FileIconEmoji}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- 1: Q indicator -->
                                    <Border Grid.Column="1" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="2,2">
                                        <TextBlock Text="📁" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                    </Border>

                                    <!-- 2: Size -->
                                    <Border Grid.Column="2" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding FormattedSizeOnly}" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 3: Status -->
                                    <Border Grid.Column="3" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 4: Time left -->
                                    <Border Grid.Column="4" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding TimeLeftText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 5: Transfer rate -->
                                    <Border Grid.Column="5" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding TransferRateText}" FontSize="11" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 6: Last Try Date -->
                                    <Border Grid.Column="6" BorderBrush="#252830" BorderThickness="0,0,1,0" Padding="8,2">
                                        <TextBlock Text="{Binding LastTryDateText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 7: Description / Host -->
                                    <Border Grid.Column="7" Padding="8,2">
                                        <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
