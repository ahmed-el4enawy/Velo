<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Velo.Desktop.Views.AboutWindow"
        Title="About Velo"
        Icon="/Assets/Velo.ico"
        Width="440" Height="290"
        MinWidth="400" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0E1015"
        Foreground="#F1F5F9">

    <Window.Styles>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#09090B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="24,7" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,20">
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Button Classes="dialogBtn" Content="OK" HorizontalAlignment="Right" Click="OnOkClick" />
        </Border>

        <!-- Body -->
        <StackPanel Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="52" Height="52" CornerRadius="12" Background="#261E0A" BorderBrush="#F59E0B" BorderThickness="1.5">
                    <TextBlock Text="⚡" FontSize="26" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Velo Download Accelerator" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Version 2.0 (High-Speed Multi-Stream Engine)" FontSize="11" Foreground="#F59E0B" />
                </StackPanel>
            </StackPanel>

            <Separator Background="#232631" Margin="0,6" />

            <TextBlock Text="Engine Status: Active (4-16 segments per stream)" FontSize="12" Foreground="#CBD5E1" />
            <TextBlock Text="Browser Integration: Google Chrome, Chromium, Firefox Native Messaging" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
            <TextBlock Text="Local Storage: SQLite WAL Mode with Crash Recovery" FontSize="11" Foreground="#94A3B8" />
        </StackPanel>
    </DockPanel>
</Window>
