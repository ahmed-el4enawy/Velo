<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velo.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="490"
        x:Class="Velo.Desktop.Views.DownloadProgressWindow"
        x:DataType="vm:DownloadProgressWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Velo.ico"
        Width="580" Height="490"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        Foreground="#F1F5F9">

    <Window.Styles>
        <Style Selector="Button.idmBtn">
            <Setter Property="Background" Value="#1A1C24" />
            <Setter Property="BorderBrush" Value="#2D303E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.idmBtn:pointerover">
            <Setter Property="Background" Value="#262419" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="#121319" />
            <Setter Property="BorderBrush" Value="#252733" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FBBF24" />
            <Setter Property="Background" Value="#181A22" />
            <Setter Property="BorderBrush" Value="#3F3924" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Segment Table Styling -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#1A1C24" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="#12141A" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n+1)">
            <Setter Property="Background" Value="#0E1015" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12,10">
        <!-- Collapsible Details Section at Bottom -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsDetailsExpanded}" Margin="0,6,0,0">
            <StackPanel Spacing="5">
                <TextBlock Text="Start positions and download progress by connections"
                           FontSize="11"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center" />

                <!-- Visual Connection Progress Graphic -->
                <Border Height="18" Background="#0A0B0E" BorderBrush="#252733" BorderThickness="1" CornerRadius="3">
                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SegmentDisplayModel">
                                <Border BorderBrush="#353945" BorderThickness="0,0,1,0">
                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercentage}"
                                                 Foreground="#F59E0B"
                                                 Background="Transparent"
                                                 BorderThickness="0" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Connection Streams Table -->
                <Border Height="110" BorderBrush="#252733" BorderThickness="1" Background="#0E1015" CornerRadius="3">
                    <DockPanel>
                        <!-- Table Header -->
                        <Border DockPanel.Dock="Top" Background="#181A22" BorderBrush="#252733" BorderThickness="0,0,0,1" Height="24">
                            <Grid ColumnDefinitions="45,130,*">
                                <Border Grid.Column="0" BorderBrush="#252733" BorderThickness="0,0,1,0" Padding="4,2">
                                    <TextBlock Text="N." FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#252733" BorderThickness="0,0,1,0" Padding="8,2">
                                    <TextBlock Text="Downloaded" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Padding="8,2">
                                    <TextBlock Text="Info" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Table Rows -->
                        <ListBox ItemsSource="{Binding Segments}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SegmentDisplayModel">
                                    <Grid ColumnDefinitions="45,130,*">
                                        <Border Grid.Column="0" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="4,1">
                                            <TextBlock Text="{Binding Index}" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#1C1E26" BorderThickness="0,0,1,0" Padding="8,1">
                                            <TextBlock Text="{Binding DownloadedText}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Padding="8,1">
                                            <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action Buttons Row -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,*">
                <Button Grid.Column="1" Classes="idmBtn" Content="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}" Width="120" Margin="4,0" />
                <Button Grid.Column="2" Classes="idmBtn" Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" Width="95" Margin="4,0" />
                <Button Grid.Column="3" Classes="idmBtn" Content="Cancel" Command="{Binding CancelDownloadCommand}" Width="95" Margin="4,0" />
            </Grid>
        </Border>

        <!-- Refined Gold Progress Bar -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,6" BorderBrush="#2A2D3A" BorderThickness="1" Height="20" Background="#0C0E13" CornerRadius="4">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding Item.ProgressPercentage}"
                         Foreground="#F59E0B"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="3"
                         Height="18" />
        </Border>

        <!-- Main Tab Control -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" Margin="0">
            <!-- TAB 1: Download status -->
            <TabItem Header="Download status">
                <Border BorderBrush="#252733" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,4,0,0" Background="#14161E">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding EffectiveUrl}"
                                   Foreground="#F8FAFC"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <!-- Status -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,3" />

                            <!-- File size -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File size" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSizeText}" FontSize="11" Foreground="#F8FAFC" Margin="0,3" />

                            <!-- Downloaded -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Downloaded" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownloadedText}" FontSize="11" Foreground="#F8FAFC" Margin="0,3" />

                            <!-- Transfer rate -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Transfer rate" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TransferRateText}" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,3" />

                            <!-- Time left -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Time left" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TimeLeftText}" FontSize="11" Foreground="#F8FAFC" Margin="0,3" />

                            <!-- Resume capability -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Resume capability" FontSize="11" Foreground="#94A3B8" Margin="0,3" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResumeCapabilityText}" FontSize="11" Foreground="#F8FAFC" Margin="0,3" />
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 2: Speed Limiter -->
            <TabItem Header="Speed Limiter">
                <Border BorderBrush="#252733" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,4,0,0" Background="#14161E">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <TextBlock Text="Transfer rate" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding TransferRateText}" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" />
                        </StackPanel>

                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Use Speed Limiter" IsChecked="{Binding UseSpeedLimiter}" FontSize="11" Foreground="#F8FAFC" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" Margin="0,0,0,10">
                            <TextBlock Text="Maximum download speed:" FontSize="11" Foreground="#94A3B8" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox Text="{Binding SpeedLimitKBytes}" Width="90" Height="26" FontSize="11" Background="#0C0E13" Foreground="#F8FAFC" BorderBrush="#2A2D3A" CornerRadius="4" />
                                <TextBlock Text="KBytes/sec" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox Grid.Row="3" Grid.Column="0" Content="Remember Speed Limiter settings for this file on download stop/resume"
                                  IsChecked="{Binding RememberSpeedLimiter}"
                                  FontSize="11" Foreground="#F8FAFC" />

                        <Button Grid.Row="3" Grid.Column="1" Classes="idmBtn" Content="Hide tab" Command="{Binding HideTabCommand}" Width="90" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: Options on completion -->
            <TabItem Header="Options on completion">
                <Border BorderBrush="#252733" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,4,0,0" Background="#14161E">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <TextBlock Text="Save To:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                            <TextBlock Text="{Binding SaveToPath}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Show download complete dialog"
                                  IsChecked="{Binding ShowDownloadCompleteDialog}"
                                  FontSize="11" Foreground="#F8FAFC" Margin="0,0,0,8" />

                        <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#232631" Margin="0,4,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="These settings are unavailable when 'Show download complete dialog' is turned on"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6" IsEnabled="{Binding !ShowDownloadCompleteDialog}">
                            <CheckBox Content="Hang up modem when done" IsChecked="{Binding HangUpModem}" FontSize="11" Foreground="#F8FAFC" />
                            <CheckBox Content="Exit Velo when done" IsChecked="{Binding ExitWhenDone}" FontSize="11" Foreground="#F8FAFC" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Turn off computer when done" IsChecked="{Binding TurnOffComputer}" FontSize="11" Foreground="#F8FAFC" />
                                <ComboBox ItemsSource="{Binding ShutdownActions}" SelectedItem="{Binding SelectedShutdownAction}"
                                          FontSize="11" Width="110" Height="26" Background="#0C0E13" Foreground="#F8FAFC" BorderBrush="#2A2D3A" CornerRadius="4" />
                            </StackPanel>
                            <CheckBox Content="Force processes to terminate" IsChecked="{Binding ForceTerminate}" IsEnabled="{Binding TurnOffComputer}" Margin="20,0,0,0" FontSize="11" Foreground="#F8FAFC" />
                        </StackPanel>

                        <Button Grid.Row="4" Grid.Column="1" Classes="idmBtn" Content="Hide tab" Command="{Binding HideTabCommand}" Width="90" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
