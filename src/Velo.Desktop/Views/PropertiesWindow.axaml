<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Velo.Desktop.Views.PropertiesWindow"
        Title="Download Properties"
        Icon="/Assets/Velo.ico"
        Width="580" Height="460"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0E1015"
        Foreground="#F1F5F9">

    <Window.Styles>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="#1A1C24" />
            <Setter Property="BorderBrush" Value="#2D303E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="#252217" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16,14">
        <!-- Bottom Buttons -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="dialogBtn" Content="Open File" Click="OnOpenFileClick" />
                <Button Classes="dialogBtn" Content="Open Folder" Click="OnOpenFolderClick" />
                <Button Classes="dialogBtn" Content="Close" Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer>
            <StackPanel Spacing="12">
                <!-- Header with Icon & Name -->
                <Border Background="#13151D" BorderBrush="#232633" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock x:Name="FileIconText" Grid.Column="0" Text="📁" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameText" Text="filename.zip" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FileSizeStatusText" Text="10.5 MB — Complete" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Details Grid -->
                <Border Background="#13151D" BorderBrush="#232633" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <!-- URL -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Address (URL):" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBox x:Name="UrlBox" IsReadOnly="True" FontSize="11" Background="#0C0E13" BorderBrush="#2A2D3A" Foreground="#CBD5E1" Height="26" />
                            <Button Grid.Column="1" Classes="dialogBtn" Content="Copy" Margin="4,0,0,0" Height="26" Click="OnCopyUrlClick" />
                        </Grid>

                        <!-- Host -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Host / Domain:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HostText" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Status -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatusText" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Save Path -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Save Path:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SavePathBox" IsReadOnly="True" FontSize="11" Background="#0C0E13" BorderBrush="#2A2D3A" Foreground="#CBD5E1" Height="26" Margin="0,2" />

                        <!-- Size & Downloaded -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Downloaded / Size:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DownloadedSizeText" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Resume Capability -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Resume Support:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResumeSupportText" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,4" />

                        <!-- ETag -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="ETag / Header:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="EtagText" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Category -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Category:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="CategoryText" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Date Created -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Added Date:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="CreatedAtText" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Date Finished -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Finished Date:" FontSize="11" Foreground="#94A3B8" Margin="0,4" />
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="FinishedAtText" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
