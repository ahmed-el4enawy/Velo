<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velo.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="330"
        x:Class="Velo.Desktop.Views.AddDownloadWindow"
        x:DataType="vm:AddDownloadWindowViewModel"
        Title="Download File Info"
        Icon="/Assets/Velo.ico"
        Width="580" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#2E2E2E"
        Foreground="#F0F0F0">

    <Window.Styles>
        <Style Selector="Button.idmActionBtn">
            <Setter Property="Background" Value="#383838" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="Button.idmActionBtn:pointerover">
            <Setter Property="Background" Value="#484848" />
            <Setter Property="BorderBrush" Value="#888888" />
        </Style>
        <Style Selector="Button.idmDefaultBtn">
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Height" Value="26" />
        </Style>
    </Window.Styles>

    <Border Padding="14,12">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="75,*">
            <!-- 1. URL -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,8" FontSize="12" Foreground="#E2E8F0" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Url}" Margin="0,0,0,8" />

            <!-- 2. Category -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,8" FontSize="12" Foreground="#E2E8F0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="250" />
                <Button Classes="idmActionBtn" Content="+" Width="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Add category" />
            </StackPanel>

            <!-- 3. Save As -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Save As" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,8" FontSize="12" Foreground="#E2E8F0" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,75" Margin="0,0,0,8">
                <TextBox Grid.Column="0" Text="{Binding SaveAsPath}" Margin="0,0,6,0" />
                <Button Grid.Column="1" Classes="idmActionBtn" Content="..." Width="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,0" Click="OnBrowseClick" />
                
                <!-- File Icon & Size -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FileCategoryIcon}" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- 4. Remember Path GroupBox -->
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#555555" BorderThickness="1" CornerRadius="2" Margin="0,0,75,8" Padding="10,6,10,8">
                <StackPanel Spacing="6">
                    <CheckBox IsChecked="{Binding RememberCategoryPath}" Margin="0,-14,0,0" Background="#2E2E2E">
                        <TextBlock Text="{Binding SelectedCategory, StringFormat='Remember this path for &quot;{0}&quot; category'}" FontSize="11" Foreground="#E2E8F0" Background="#2E2E2E" Padding="4,0" />
                    </CheckBox>
                    <TextBox Text="{Binding CategoryFolderPath}" IsReadOnly="True" FontSize="11" Height="24" Background="#222222" BorderBrush="#444444" Foreground="#94A3B8" />
                </StackPanel>
            </Border>

            <!-- 5. Description -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Description" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,12" FontSize="12" Foreground="#E2E8F0" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Description}" Margin="0,0,75,12" />

            <!-- 6. Footer Buttons -->
            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" VerticalAlignment="Bottom" Margin="0,4,0,2">
                <Button Classes="idmActionBtn" Content="Download Later" Command="{Binding DownloadLaterCommand}" Width="125" />
                <Button Classes="idmActionBtn idmDefaultBtn" Content="Start Download" Command="{Binding StartDownloadCommand}" Width="125" IsDefault="True" />
                <Button Classes="idmActionBtn" Content="Cancel" Click="OnCancelClick" Width="100" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
